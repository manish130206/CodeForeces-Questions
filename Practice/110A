#include <iostream>
using namespace std;

bool isLucky(int x) {
    if (x == 0) return false;
    while (x > 0) {
        int d = x % 10;
        if (d != 4 && d != 7)
            return false;
        x /= 10;
    }
    return true;
}

int main() {
    long long n;
    cin >> n;

    int countLuckyDigits = 0;

    while (n > 0) {
        int digit = n % 10;
        if (digit == 4 || digit == 7)
            countLuckyDigits++;
        n /= 10;
    }

    if (isLucky(countLuckyDigits))
        cout << "YES";
    else
        cout << "NO";

    return 0;
}
